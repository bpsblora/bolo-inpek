rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function canUpdateFasih() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/operators/$(request.auth.uid))
        && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.active == true);
    }
    function validSurvey() {
      return request.resource.data.keys().hasOnly([
        'id', 'name', 'sourceCode', 'startDate', 'endDate', 'active'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() <= 100
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 100
      && request.resource.data.sourceCode is string
      && request.resource.data.sourceCode.size() <= 100
      && request.resource.data.startDate is string
      && request.resource.data.endDate is string
      && request.resource.data.active is bool;
    }
    function validEmployee() {
      return request.resource.data.keys().hasOnly([
        'id', 'name', 'email', 'phone', 'role', 'note', 'active'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() <= 100
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.email is string
      && request.resource.data.email.size() <= 200
      && request.resource.data.phone is string
      && request.resource.data.phone.size() <= 24
      && request.resource.data.role in ['PPL', 'PML', 'PPL/PML', 'Pegawai']
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 600
      && request.resource.data.active is bool;
    }

    // Metadata survei boleh dibaca agar dashboard publik bisa menampilkannya.
    // Tidak boleh berisi nomor telepon, kredensial, atau catatan pribadi.
    match /surveys/{surveyId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.id == surveyId
        && validSurvey();
      allow delete: if false;
    }

    // ID survei, periode dan peran FASIH hanya untuk admin; jangan dibaca publik.
    function validScraperConfig() {
      return request.resource.data.keys().hasOnly([
        'id', 'name', 'code', 'survey_id', 'survey_period_id',
        'role_pencacah_id', 'role_pengawas_id', 'nama_assignment_field'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() > 0
      && request.resource.data.id.size() <= 100
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 100
      && request.resource.data.code is string
      && request.resource.data.code.size() > 0
      && request.resource.data.code.size() <= 140
      && request.resource.data.survey_id is string
      && request.resource.data.survey_id.size() > 0
      && request.resource.data.survey_id.size() <= 140
      && request.resource.data.survey_period_id is string
      && request.resource.data.survey_period_id.size() > 0
      && request.resource.data.survey_period_id.size() <= 140
      && request.resource.data.role_pencacah_id is string
      && request.resource.data.role_pencacah_id.size() > 0
      && request.resource.data.role_pencacah_id.size() <= 140
      && request.resource.data.role_pengawas_id is string
      && request.resource.data.role_pengawas_id.size() > 0
      && request.resource.data.role_pengawas_id.size() <= 140
      && request.resource.data.nama_assignment_field is string
      && request.resource.data.nama_assignment_field.size() > 0
      && request.resource.data.nama_assignment_field.size() <= 140;
    }
    match /scraper_configs/{surveyId} {
      allow read: if canUpdateFasih();
      allow create, update: if isAdmin()
        && request.resource.data.id == surveyId
        && validScraperConfig();
      allow delete: if false;
    }

    // Identitas dan nomor kontak petugas hanya bisa dilihat/diedit admin.
    match /employees/{employeeId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.id == employeeId
        && validEmployee();
      allow delete: if false;
    }

    // ID dua spreadsheet hanya tersedia untuk admin/operator yang berwenang.
    // Jangan simpan password, private key, token OAuth, atau isi data survei.
    function validSheetTargets() {
      return request.resource.data.keys().hasOnly([
        'monitoring_id', 'tindak_lanjut_id'
      ])
      && request.resource.data.keys().hasAll([
        'monitoring_id', 'tindak_lanjut_id'
      ])
      && request.resource.data.monitoring_id is string
      && request.resource.data.tindak_lanjut_id is string
      && request.resource.data.monitoring_id.matches('^[A-Za-z0-9_-]{20,150}
    // Penunjukan operator dilakukan oleh administrator melalui Firebase Console.
    match /operators/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Admin ditetapkan lewat Firebase Console, tidak bisa mengangkat diri.
    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
      && request.resource.data.tindak_lanjut_id.matches('^[A-Za-z0-9_-]{20,150}
    // Penunjukan operator dilakukan oleh administrator melalui Firebase Console.
    match /operators/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Admin ditetapkan lewat Firebase Console, tidak bisa mengangkat diri.
    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
      && request.resource.data.monitoring_id != request.resource.data.tindak_lanjut_id;
    }
    match /system_config/{configId} {
      allow get: if configId == 'sheets' && canUpdateFasih();
      allow list: if false;
      allow create, update: if configId == 'sheets'
        && isAdmin() && validSheetTargets();
      allow delete: if false;
    }

    // Peran operator hanya memberi izin READ konfigurasi updater.
    // Penunjukan operator dilakukan oleh administrator melalui Firebase Console.
    match /operators/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Admin ditetapkan lewat Firebase Console, tidak bisa mengangkat diri.
    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
